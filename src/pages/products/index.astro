---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
const products = await getCollection("products");
const { pathname } = Astro.url;
---

<Layout title="Coffee Products">
  <header class="bg-primary px-4 sm:px-8 pb-4 sm:pb-8 rounded-b-lg pt-24">
    <h1
      class="text-3xl sm:text-5xl tracking-tight text-balance text-primary-foreground max-w-prose leading-[1.1]"
    >
      Coffee Products. <span
        class="text-[color-mix(in_srgb,var(--color-primary-foreground),var(--color-primary)_50%)]"
        >Gear for brewing and enjoying excellent coffee at home.</span
      >
    </h1>
  </header>

  <section class="mt-4 bg-muted rounded-lg p-4 sm:p-8">
    <!-- <nav class="mb-8">
      <ul class="flex gap-x-2">
        {
          [
            {
              label: "All",
              pathname: "/products",
            },
            {
              label: "Automatic",
              pathname: "/products/automatic",
            },
            {
              label: "Espresso",
              pathname: "/products/espresso",
            },
            {
              label: "Pour over",
              pathname: "/products/pour-over",
            },
          ].map((item) => {
            return (
              <li>
                <a
                  aria-current={pathname === item.pathname ? "page" : undefined}
                  class:list={[
                    "text-sm font-medium border rounded-full h-9 px-4 inline-flex items-center justify-center border-black/10 aria-[current]:bg-white",
                  ]}
                  href={item.pathname}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav> -->
    <ul
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 2xl:grid-cols-5 gap-4"
    >
      {
        products.map((product) => {
          const { title, description, img } = product.data;
          if (!img) return null;
          return (
            <li class="bg-white rounded-md overflow-hidden flex flex-col relative group">
              {img ? (
                <div class="aspect-[4/3] relative overflow-hidden">
                  <img
                    src={product.data.img}
                    class="absolute size-full object-contain group-hover:opacity-80 transition-opacity duration-250 ease-out"
                  />
                </div>
              ) : null}
              <div class="px-4 pt-1 pb-4 flex flex-col flex-1">
                <p class="text-xs font-mono uppercase tracking-widest opacity-70 flex justify-between">
                  <span>{description}</span>
                  {product.data.pricePoint ? (
                    <span>{product.data.pricePoint}</span>
                  ) : null}
                </p>
                <h2 class="mt-1 font-semibold tracking-tight leading-tight text-sm text-pretty text-primary">
                  <a
                    href={product.data.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="after:absolute after:inset-0"
                  >
                    {title}
                  </a>
                </h2>
              </div>
            </li>
          );
        })
      }
    </ul>
  </section>
</Layout>
