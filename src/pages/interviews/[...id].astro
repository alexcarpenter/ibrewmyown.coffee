---
import Layout from "@/layouts/Layout.astro";
import { getSlugFromId, getIndexById, isProd } from "@/utils";
import { type CollectionEntry, getCollection, render } from "astro:content";
import { Image } from "astro:assets";
export async function getStaticPaths() {
  const collection = await getCollection("interviews", ({ data }) => {
    return isProd ? data.draft !== true : true;
  });
  const interviews = collection.sort((a, b) => {
    const aDate = a.data.published;
    const bDate = b.data.published;
    return Date.parse(bDate.toString()) - Date.parse(aDate.toString());
  });
  return interviews.map((interview, index) => {
    const id = getSlugFromId(interview.id);
    const issue = getIndexById(interviews, interview.id);
    const totalIssues = interviews.length;
    const previous =
      index < totalIssues - 1 ? interviews[index + 1] : undefined;
    const next = index > 0 ? interviews[index - 1] : undefined;
    return {
      params: { id },
      props: {
        issue,
        interview,
        previous,
        next,
      },
    };
  });
}
type Props = {
  issue: string;
  interview: CollectionEntry<"interviews">;
  previous: CollectionEntry<"interviews"> | undefined;
  next: CollectionEntry<"interviews"> | undefined;
};
const {
  issue: _issue,
  interview,
  previous: _previous,
  next: _next,
} = Astro.props;
const { Content } = await render(interview);
---

<Layout
  title={interview.data.title}
  description={interview.data.description}
  image={interview.data.image}
>
  <article class="my-20">
    <header class="max-w-lg mx-auto text-pretty">
      <Image
        src={interview.data.avatar}
        width="48"
        height="48"
        alt=""
        class="rounded-full object-cover aspect-square size-10"
      />
      <div class="mt-5">
        <h1 class="text-sm font-medium inline">{interview.data.title}.</h1>
        <p class="inline mt-5 text-sm text-neutral-500">
          {interview.data.description}
        </p>
      </div>
    </header>
    {
      interview.data.gallery ? (
        <div class="embla max-w-3xl mx-auto mt-10">
          <div class="embla__viewport">
            <div class="embla__container">
              {interview.data.gallery.map((image) => (
                <div class="embla__slide">
                  <Image
                    src={image.src}
                    width="1600"
                    height="900"
                    alt={image.alt}
                  />
                </div>
              ))}
            </div>
          </div>
          <div class="embla__dots" />
        </div>
      ) : null
    }
    <div class="prose mt-10 max-w-lg mx-auto">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .embla__viewport {
    overflow: hidden;
    width: 100%;
  }

  .embla__container {
    display: flex;
    width: 100%;
    touch-action: pan-y pinch-zoom;
  }

  .embla__slide {
    flex: 0 0 100%;
    min-width: 0;
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .embla__dots {
    display: flex;
    justify-content: center;
    align-items: end;
    height: calc(var(--spacing) * 8);
    gap: calc(var(--spacing) * 2);

    button {
      width: calc(var(--spacing) * 2);
      height: calc(var(--spacing) * 2);
      border-radius: 50%;
      background-color: var(--color-neutral-300);

      &.active {
        background-color: var(--color-neutral-500);
      }
    }
  }
</style>

<script>
  import EmblaCarousel, { type EmblaOptionsType } from "embla-carousel";
  import { addDotBtnsAndClickHandlers } from "@/lib/embla";

  const OPTIONS: EmblaOptionsType = {};

  const emblaNode = document.querySelector(".embla") as HTMLElement;
  const viewportNode = emblaNode.querySelector(
    ".embla__viewport",
  ) as HTMLElement;
  const dotsNode = document.querySelector(".embla__dots") as HTMLElement;
  const emblaApi = EmblaCarousel(viewportNode, OPTIONS);

  addDotBtnsAndClickHandlers(emblaApi, dotsNode);
</script>
