---
import Layout from "@/layouts/Layout.astro";
import { getSlugFromId, getIndexById, isProd } from "@/utils";
import { type CollectionEntry, getCollection, render } from "astro:content";
import { Image } from "astro:assets";
export async function getStaticPaths() {
  const collection = await getCollection("interviews", ({ data }) => {
    return isProd ? data.draft !== true : true;
  });
  const interviews = collection.sort((a, b) => {
    const aDate = a.data.published;
    const bDate = b.data.published;
    return Date.parse(bDate.toString()) - Date.parse(aDate.toString());
  });
  return interviews.map((interview, index) => {
    const id = getSlugFromId(interview.id);
    const issue = getIndexById(interviews, interview.id);
    const totalIssues = interviews.length;
    const previous =
      index < totalIssues - 1 ? interviews[index + 1] : undefined;
    const next = index > 0 ? interviews[index - 1] : undefined;
    return {
      params: { id },
      props: {
        issue,
        interview,
        previous,
        next,
      },
    };
  });
}
type Props = {
  issue: string;
  interview: CollectionEntry<"interviews">;
  previous: CollectionEntry<"interviews"> | undefined;
  next: CollectionEntry<"interviews"> | undefined;
};
const {
  issue: _issue,
  interview,
  previous: _previous,
  next: _next,
} = Astro.props;
const { Content } = await render(interview);
---

<Layout
  title={interview.data.title}
  description={interview.data.description}
  image={interview.data.image}
>
  <article class="my-20">
    <header class="max-w-lg mx-auto text-pretty">
      <Image
        src={interview.data.avatar}
        width="48"
        height="48"
        alt=""
        class="rounded-full object-cover aspect-square size-10"
      />
      <div class="mt-5">
        <h1 class="text-sm font-medium inline">{interview.data.title}.</h1>
        <p class="inline mt-5 text-sm text-neutral-500">
          {interview.data.description}
        </p>
      </div>
    </header>
    {
      interview.data.gallery ? (
        <div class="embla max-w-3xl mx-auto mt-10">
          <div class="embla__viewport">
            <div class="embla__container">
              {interview.data.gallery.map((image) => (
                <Image
                  src={image.src}
                  width="1600"
                  height="900"
                  alt={image.alt}
                  class="embla__slide"
                />
              ))}
            </div>
          </div>

          <div class="embla__dots" />
        </div>
      ) : null
    }
    <div class="prose mt-10 max-w-lg mx-auto">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .embla__viewport {
    overflow: hidden;
    width: 100%;
  }

  .embla__container {
    display: flex;
    width: 100%;
    touch-action: pan-y pinch-zoom;
  }

  .embla__slide {
    flex: 0 0 100%;
    min-width: 0;
    position: relative;
    object-fit: cover;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .embla__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    height: calc(var(--spacing) * 10);
  }
</style>

<script>
  import EmblaCarousel, { type EmblaCarouselType } from "embla-carousel";

  const wrapperNode = document.querySelector<HTMLElement>(".embla");
  if (!wrapperNode) throw new Error("Embla wrapper not found");

  const viewportNode =
    wrapperNode.querySelector<HTMLElement>(".embla__viewport");
  const dotsNode = wrapperNode.querySelector<HTMLElement>(".embla__dots");

  if (!viewportNode || !dotsNode) {
    throw new Error("Embla viewport or dots not found");
  }

  const emblaApi: EmblaCarouselType = EmblaCarousel(viewportNode, {
    loop: false,
  });

  let dotNodes: HTMLElement[] = [];

  const createDotButtonHtml = (
    emblaApi: EmblaCarouselType,
    dotsNode: HTMLElement,
  ) => {
    const scrollSnaps = emblaApi.scrollSnapList();
    dotsNode.innerHTML = scrollSnaps
      .map(
        () =>
          `<button class="embla__dot h-10 w-6 group flex justify-center items-center" type="button" aria-label="Go to slide">
            <span class="size-2 rounded-full bg-neutral-300 block group-[[aria-current=true]]:bg-neutral-900"></span>
          </button>`,
      )
      .join("");
    return Array.from(dotsNode.querySelectorAll<HTMLElement>(".embla__dot"));
  };

  const addDotButtonClickHandlers = (
    emblaApi: EmblaCarouselType,
    dotNodes: HTMLElement[],
  ) => {
    dotNodes.forEach((dotNode, index) => {
      dotNode.addEventListener("click", () => emblaApi.scrollTo(index), false);
    });
  };

  const toggleDotButtonsActive = (
    emblaApi: EmblaCarouselType,
    dotNodes: HTMLElement[],
  ) => {
    if (!dotNodes.length) return;
    const previous = emblaApi.previousScrollSnap();
    const selected = emblaApi.selectedScrollSnap();
    if (previous !== -1) {
      dotNodes[previous].removeAttribute("aria-current");
    }
    dotNodes[selected].setAttribute("aria-current", "true");
  };

  const createAndSetupDotButtons = (
    emblaApi: EmblaCarouselType,
    dotsNode: HTMLElement,
  ) => {
    dotNodes = createDotButtonHtml(emblaApi, dotsNode);
    addDotButtonClickHandlers(emblaApi, dotNodes);
    toggleDotButtonsActive(emblaApi, dotNodes);
  };

  createAndSetupDotButtons(emblaApi, dotsNode);
  emblaApi.on("init", () => createAndSetupDotButtons(emblaApi, dotsNode));
  emblaApi.on("select", (emblaApi) =>
    toggleDotButtonsActive(emblaApi, dotNodes),
  );
</script>
