---
import Layout from "@/layouts/default-layout.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
const products = await getCollection("products");
const { pathname } = Astro.url;
---

<Layout
  title="Coffee Products"
  description="Discover the best home coffee equipment. Browse our curated selection of espresso machines, grinders, pour-over brewers, kettles, and specialty coffee accessories."
>
  <h1 class="sr-only">Coffee Products</h1>
  <ul
    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 2xl:grid-cols-5 gap-4"
  >
    {
      products.map((product) => {
        const { title, description, img } = product.data;
        if (!img) return null;
        return (
          <li class="bg-white rounded-lg overflow-hidden flex flex-col relative group/card">
            {img ? (
              <div class="aspect-[4/3] relative overflow-hidden">
                <img
                  src={product.data.img}
                  alt={title}
                  width={400}
                  height={300}
                  class="w-full h-full object-contain group-hover:opacity-80 transition-opacity duration-250 ease-out"
                />
              </div>
            ) : null}
            <div class="px-4 pt-1 pb-4 flex flex-col flex-1">
              <p class="text-xxs tracking-widest font-mono uppercase text-muted-foreground flex justify-between">
                <span>{description}</span>
                {/* {product.data.pricePoint ? (
                    <span>{product.data.pricePoint}</span>
                  ) : null} */}
              </p>
              <h2 class="mt-1 font-medium text-sm text-pretty">
                <a
                  href={product.data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="after:absolute after:inset-0 pe-3.5 inline-block"
                >
                  {title}
                  <span class="absolute h-[1lh] inline-flex items-center pl-1 overflow-clip">
                    <Icon
                      name="arrow-right"
                      class="size-3.5 opacity-0 group-hover/card:opacity-70 motion-reduce:transition-none duration-250 -translate-x-6 group-hover/card:translate-x-0 transition ease-custom"
                    />
                  </span>
                </a>
              </h2>
            </div>
          </li>
        );
      })
    }
  </ul>
</Layout>
