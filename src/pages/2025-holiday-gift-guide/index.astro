---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/button.astro";
import { TooltipAnchor } from "@/components/tooltipanchor.react";
import brevilleBarristaImage from "@/assets/breville-barista@2x.png";
import moccamasterImage from "@/assets/moccamaster@2x.png";
import kalitaWaveImage from "@/assets/kalita-wave@2x.png";

const products = await getCollection("products");

const getProductData = (id: string) =>
  products.find((product) => product.id === id)?.data;

const tierOneStockingStuffers = [
  "normcore-dosing-funnel",
  "normcore-espresso-measuring-cup",
  "normcore-spring-loaded-tamper",
  "normcore-wdt-distribution-tool",
  "timemore-coffee-scale-basic-2-0",
].map((id) => getProductData(id));

const tierTwoStockingStuffers = [
  "fellow-opus-conical-burr-coffee-grinder",
  "technivorm-moccamaster-4-white-paper-filters",
  "urnex-coffee-maker-cleaner-and-descaler-kit",
  "notneutral-lino-porcelain-coffee-cup",
  "fellow-atmos-electric-vacuum-canister",
].map((id) => getProductData(id));

const tierThreeStockingStuffers = [
  "baratza-encore-grinder",
  "kalita-wave-paper-coffee-filters",
  "fellow-stagg-ekg-electric-gooseneck-kettle",
  "kalita-wave-series-500-server",
  "third-wave-water-classic-light-roast",
].map((id) => getProductData(id));
---

<Layout
  title="2025 Holiday Coffee Gift Guide"
  description="Discover the best coffee gifts for the holidays—espresso machines, drippers, brewers, and bean subscriptions that coffee lovers will actually use every day."
  image="/og/2025-holiday-gift-guide.jpg"
>
  <article class="my-20">
    <header class="max-w-lg mx-auto text-pretty">
      <div class="mt-5">
        <h1 class="text-sm font-medium inline">
          2025 Holiday Coffee Gift Guide.
        </h1>
        <p class="inline mt-5 text-sm text-neutral-500">
          Discover the best coffee gifts for the holidays—espresso machines,
          drippers, brewers, and bean subscriptions that coffee lovers will
          actually use every day.
        </p>
      </div>
    </header>
    <ul>
      <li id="tier-one" class="scroll-mt-20 py-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <div class="flex justify-center">
            <Image
              src={brevilleBarristaImage}
              alt="Breville Barista Express"
              class="rounded-lg overflow-hidden max-w-lg"
            />
          </div>
          <div class="max-w-xl max-lg:mx-auto">
            <p
              class="text-xxs font-mono uppercase text-muted-foreground tracking-widest"
            >
              Tier one&nbsp;&not;
            </p>
            <div class="text-pretty mt-5">
              <h2 class="text-sm font-medium inline">
                Breville Barista Express Espresso Machine.
              </h2>
              <p class="inline text-sm text-muted-foreground">
                The Breville Barista Express has everything you need to make
                café-quality espresso at home—built-in grinder, steam wand, and
                precise temperature control. It's a solid machine for anyone who
                takes their coffee seriously but doesn't want to deal with
                multiple gadgets cluttering the counter. Great for daily use and
                way more satisfying than pod machines.
              </p>
            </div>
            <div class="mt-10">
              <Button href="https://amzn.to/4p8DCUn">Purchase</Button>
            </div>
            <div class="mt-10">
              <p
                class="text-xxs font-mono uppercase text-muted-foreground tracking-widest"
              >
                Stocking stuffers:
              </p>
              <ul class="mt-5 grid grid-cols-5 gap-2 md:gap-4">
                {
                  tierOneStockingStuffers.map((item) => {
                    if (!item) return null;
                    return (
                      <li>
                        <TooltipAnchor
                          description={item.title}
                          href={item.link}
                          src={item.img!}
                          alt={item.title}
                          client:load
                        />
                      </li>
                    );
                  })
                }
              </ul>
            </div>
          </div>
        </div>
      </li>
      <li
        id="tier-two"
        class="scroll-mt-20 py-20 border-t border-black/10 border-dashed"
      >
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <div class="flex justify-center lg:order-1">
            <Image
              src={moccamasterImage}
              alt="Moccamaster KBGV Select Coffee Brewer"
              class="rounded-lg overflow-hidden max-w-lg"
            />
          </div>
          <div class="max-w-xl mx-auto lg:ml-auto">
            <p
              class="text-xxs font-mono uppercase text-muted-foreground tracking-widest"
            >
              Tier two&nbsp;&not;
            </p>
            <div class="text-pretty mt-5">
              <h2 class="text-sm font-medium inline">
                Moccamaster KBGV Select Coffee Brewer.
              </h2>
              <p class="inline text-sm text-muted-foreground">
                The Moccamaster KBGV Select brews coffee at the perfect
                temperature and speed, which is why it's certified by coffee
                nerds everywhere. It's built like a tank in the Netherlands,
                looks great on the counter, and makes consistently excellent
                drip coffee. If someone's still using a cheap Mr. Coffee, this
                is a serious upgrade that'll last them years.
              </p>
            </div>
            <div class="mt-10">
              <Button href="https://amzn.to/4oupwMa">Purchase</Button>
            </div>
            <div class="mt-10">
              <p
                class="text-xs font-mono uppercase text-muted-foreground tracking-widest"
              >
                Stocking stuffers:
              </p>
              <ul class="mt-5 grid grid-cols-5 gap-2 md:gap-4">
                {
                  tierTwoStockingStuffers.map((item) => {
                    if (!item) return null;
                    return (
                      <li>
                        <TooltipAnchor
                          description={item.title}
                          href={item.link}
                          src={item.img!}
                          alt={item.title}
                          client:load
                        />
                      </li>
                    );
                  })
                }
              </ul>
            </div>
          </div>
        </div>
      </li>
      <li
        id="tier-three"
        class="scroll-mt-20 py-20 border-t border-black/10 border-dashed"
      >
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <div class="flex justify-center">
            <Image
              src={kalitaWaveImage}
              alt="Kalita Wave 185 Stainless Steel Coffee Dripper"
              class="rounded-lg overflow-hidden max-w-lg"
            />
          </div>
          <div class="max-w-xl max-lg:mx-auto">
            <p
              class="text-xxs font-mono uppercase text-muted-foreground tracking-widest"
            >
              Tier three&nbsp;&not;
            </p>
            <div class="text-pretty mt-5">
              <h2 class="text-sm font-medium inline">
                Kalita Wave 185 Stainless Steel Coffee Dripper
              </h2>
              <p class="inline text-sm text-muted-foreground">
                The Kalita Wave 185 is a pour-over dripper that makes brewing
                feel like a little morning ritual. The flat-bottom design and
                three-hole drainage give you an even extraction, so your coffee
                tastes clean and balanced. It's perfect for anyone who wants to
                slow down and actually enjoy the process.
              </p>
            </div>
            <div class="mt-10">
              <Button href="https://amzn.to/4p7Cxfw">Purchase</Button>
            </div>
            <div class="mt-10">
              <p
                class="text-xxs font-mono uppercase text-muted-foreground tracking-widest"
              >
                Stocking stuffers:
              </p>
              <ul class="mt-5 grid grid-cols-5 gap-2 md:gap-x-4">
                {
                  tierThreeStockingStuffers.map((item) => {
                    if (!item) return null;
                    return (
                      <li>
                        <TooltipAnchor
                          description={item.title}
                          href={item.link}
                          src={item.img!}
                          alt={item.title}
                          client:load
                        />
                      </li>
                    );
                  })
                }
              </ul>
            </div>
          </div>
        </div>
      </li>
      <li
        id="coffee-subscription"
        class="scroll-mt-20 pt-20 border-t border-black/10 border-dashed"
      >
        <div class="max-w-xl mx-auto">
          <p
            class="text-xxs font-mono uppercase text-muted-foreground tracking-widest"
          >
            Coffee Subscription&nbsp;&not;
          </p>
          <div class="mt-5 text-pretty">
            <h2 class="inline text-sm font-medium">
              Trade Coffee Subscription.
            </h2>
            <p class="inline text-sm text-muted-foreground">
              Now that you've got the gear, keep it stocked with Trade Coffee.
              They match you with beans from top roasters based on your taste
              preferences, then ship fresh bags right to your door. It's like
              having a coffee expert curating your stash—no more guessing at the
              grocery store or ending up with stale beans from who knows where.
            </p>
          </div>
          <div class="mt-10">
            <Button href="https://rwrd.io/ref_2JQN4EP?c">Subscribe</Button>
          </div>
        </div>
      </li>
    </ul>
  </article>
</Layout>
