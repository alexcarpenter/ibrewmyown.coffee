---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/button.astro";
import { TooltipAnchor } from "@/components/tooltipanchor.react";
import brevilleBarristaImage from "@/assets/breville-barista@2x.png";
import moccamasterImage from "@/assets/moccamaster@2x.png";
import laMarzoccoLineaMicra from "@/assets/la-marzocco-linea-micra@2x.png";

const products = await getCollection("products");

const getProductData = (id: string) =>
  products.find((product) => product.id === id)?.data;

const tierOneAccessories = [].map((id) => getProductData(id));

const tierTwoAccessories = [].map((id) => getProductData(id));

const tierThreeAccessories = ["la-marzocco-pico"].map((id) =>
  getProductData(id)
);
---

<Layout
  title="Espresso setups"
  description="Discover the best coffee gifts for the holidays—espresso machines, drippers, brewers, and bean subscriptions that coffee lovers will actually use every day."
  image="/og/2025-holiday-gift-guide.jpg"
>
  <header class="bg-primary px-4 sm:px-8 rounded-b-lg py-24 relative">
    <h1 class="sr-only">Espresso setups</h1>
    <svg fill="none" viewBox="0 0 414 123" class="fill-accent max-h-32 mx-auto"
      ><path
        d="M412.709 44.928h-9.472V11.776c0-2.048-1.152-3.328-3.2-3.328s-3.072 1.28-3.072 3.072v32.768c0 3.84.896 5.632 3.712 7.424l4.352 2.304c5.12 2.944 8.064 5.76 8.064 13.696v41.984c0 7.936-4.864 12.416-12.672 12.416-8.064 0-13.056-4.352-13.056-11.776V70.272h9.6v39.68c0 2.176 1.152 3.712 3.328 3.712 2.048 0 3.072-1.536 3.072-3.584V70.528c0-4.224-1.024-6.144-3.84-7.808l-4.608-2.432c-5.248-2.944-7.68-6.272-7.68-13.824V11.648C387.237 4.736 391.589 0 400.293 0c8.32 0 12.416 4.224 12.416 11.264v33.664ZM370.056 81.024h-3.584v40.448H357V.512h13.056c7.552 0 12.672 4.096 12.672 12.416v55.424c0 8.32-5.376 12.672-12.672 12.672Zm-.768-8.576c2.432 0 3.712-1.536 3.712-4.608V13.568c0-2.944-1.408-4.48-3.712-4.48h-2.816v63.36h2.816ZM350.716.512v109.952c0 7.68-4.992 11.648-12.672 11.648-7.808 0-12.672-3.968-12.672-11.52V.512h9.6v109.44c0 2.56 1.28 3.712 3.072 3.712s2.944-1.152 2.944-3.712V.512h9.728ZM322.26.512v8.576h-7.68v112.384h-9.6V9.216h-7.808V.64L322.26.512ZM286.725 112.896h9.344v8.576h-18.944V.512h18.688v8.576h-9.088V54.4h8.576v8.448h-8.576v50.048ZM270.96 44.928h-9.472V11.776c0-2.048-1.152-3.328-3.2-3.328s-3.072 1.28-3.072 3.072v32.768c0 3.84.896 5.632 3.712 7.424l4.352 2.304c5.12 2.944 8.064 5.76 8.064 13.696v41.984c0 7.936-4.864 12.416-12.672 12.416-8.064 0-13.056-4.352-13.056-11.776V70.272h9.6v39.68c0 2.176 1.152 3.712 3.328 3.712 2.048 0 3.072-1.536 3.072-3.584V70.528c0-4.224-1.024-6.144-3.84-7.808l-4.608-2.432c-5.248-2.944-7.68-6.272-7.68-13.824V11.648C245.488 4.736 249.84 0 258.544 0c8.32 0 12.416 4.224 12.416 11.264v33.664ZM214.919 0c8.448 0 12.928 4.608 12.928 13.056V108.8c0 8.576-4.608 13.312-12.928 13.312-8.448 0-12.928-4.736-12.928-13.312V13.056c0-8.448 4.48-13.056 12.928-13.056Zm3.2 109.696V12.288c0-2.304-1.152-3.84-3.2-3.84s-3.2 1.408-3.2 3.84v97.408c0 2.432 1.28 3.968 3.2 3.968 1.92 0 3.2-1.664 3.2-3.968ZM196.21 44.928h-9.472V11.776c0-2.048-1.152-3.328-3.2-3.328s-3.072 1.28-3.072 3.072v32.768c0 3.84.896 5.632 3.712 7.424l4.352 2.304c5.12 2.944 8.064 5.76 8.064 13.696v41.984c0 7.936-4.864 12.416-12.672 12.416-8.064 0-13.056-4.352-13.056-11.776V70.272h9.6v39.68c0 2.176 1.152 3.712 3.328 3.712 2.048 0 3.072-1.536 3.072-3.584V70.528c0-4.224-1.024-6.144-3.84-7.808l-4.608-2.432c-5.248-2.944-7.68-6.272-7.68-13.824V11.648C170.738 4.736 175.09 0 183.794 0c8.32 0 12.416 4.224 12.416 11.264v33.664ZM165.085 44.928h-9.472V11.776c0-2.048-1.152-3.328-3.2-3.328s-3.072 1.28-3.072 3.072v32.768c0 3.84.896 5.632 3.712 7.424l4.352 2.304c5.12 2.944 8.064 5.76 8.064 13.696v41.984c0 7.936-4.864 12.416-12.672 12.416-8.064 0-13.056-4.352-13.056-11.776V70.272h9.6v39.68c0 2.176 1.152 3.712 3.328 3.712 2.048 0 3.072-1.536 3.072-3.584V70.528c0-4.224-1.024-6.144-3.84-7.808l-4.608-2.432c-5.248-2.944-7.68-6.272-7.68-13.824V11.648C139.613 4.736 143.965 0 152.669 0c8.32 0 12.416 4.224 12.416 11.264v33.664ZM126.35 112.896h9.344v8.576H116.75V.512h18.688v8.576h-9.088V54.4h8.576v8.448h-8.576v50.048ZM111.874 121.472h-9.6l-3.2-49.152h-4.352v49.152H85.25V.512h13.056c7.552 0 12.544 3.968 12.544 12.288v46.336c0 4.224-1.408 7.168-3.328 9.088l4.352 53.248ZM94.85 63.744h2.432c2.56 0 3.84-1.408 3.84-4.608v-45.44c0-3.072-1.408-4.608-3.84-4.608H94.85v54.656ZM67.556 81.024h-3.584v40.448H54.5V.512h13.056c7.552 0 12.672 4.096 12.672 12.416v55.424c0 8.32-5.376 12.672-12.672 12.672Zm-.768-8.576c2.432 0 3.712-1.536 3.712-4.608V13.568c0-2.944-1.408-4.48-3.712-4.48h-2.816v63.36h2.816ZM48.335 44.928h-9.472V11.776c0-2.048-1.152-3.328-3.2-3.328s-3.072 1.28-3.072 3.072v32.768c0 3.84.896 5.632 3.712 7.424l4.352 2.304c5.12 2.944 8.064 5.76 8.064 13.696v41.984c0 7.936-4.864 12.416-12.672 12.416-8.064 0-13.056-4.352-13.056-11.776V70.272h9.6v39.68c0 2.176 1.152 3.712 3.328 3.712 2.048 0 3.072-1.536 3.072-3.584V70.528c0-4.224-1.024-6.144-3.84-7.808l-4.608-2.432c-5.248-2.944-7.68-6.272-7.68-13.824V11.648C22.863 4.736 27.215 0 35.92 0c8.32 0 12.416 4.224 12.416 11.264v33.664ZM9.6 112.896h9.344v8.576H0V.512h18.688v8.576H9.6V54.4h8.576v8.448H9.6v50.048Z"
      ></path></svg
    >
    <p
      class="text-white text-xl max-w-2xl text-balance mx-auto mt-8 text-center"
    >
      Discover the best coffee gifts for the holidays—espresso machines,
      drippers, brewers, and bean subscriptions that coffee lovers will actually
      use every day.
    </p>
  </header>
  <section class="mt-4 bg-muted rounded-lg">
    <ul>
      <li id="tier-one" class="scroll-mt-24">
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center px-4 py-16 lg:p-0"
        >
          <div class="lg:p-8 flex justify-center">
            <Image
              src={brevilleBarristaImage}
              alt="Breville Barista Express"
              class="rounded-lg overflow-hidden max-w-lg"
            />
          </div>
          <div class="lg:px-8 lg:py-24">
            <p class="text-xs font-mono uppercase opacity-70 tracking-widest">
              Tier one&nbsp;&not;
            </p>
            <h2
              class="my-4 text-3xl sm:text-5xl tracking-tight text-balance text-primary leading-[1.1]"
            >
              Breville Barista Express Espresso Machine
            </h2>
            <p class="md:text-xl opacity-70">
              The Breville Barista Express has everything you need to make
              café-quality espresso at home—built-in grinder, steam wand, and
              precise temperature control. It's a solid machine for anyone who
              takes their coffee seriously but doesn't want to deal with
              multiple gadgets cluttering the counter. Great for daily use and
              way more satisfying than pod machines.
            </p>
            <div class="mt-8">
              <Button href="https://amzn.to/4p8DCUn">Purchase</Button>
            </div>
            {
              tierOneAccessories.length ? (
                <div class="mt-8">
                  <p class="text-xs font-mono uppercase opacity-70 tracking-widest">
                    Extra accessories:
                  </p>
                  <ul class="mt-4 grid grid-cols-5 gap-2 md:gap-4">
                    {tierOneAccessories.map((item) => {
                      if (!item) return null;
                      return (
                        <li>
                          <TooltipAnchor
                            description={item.title}
                            href={item.link}
                            src={item.img!}
                            alt={item.title}
                            client:load
                          />
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ) : null
            }
          </div>
        </div>
      </li>
      <li
        id="tier-two"
        class="scroll-mt-24 border-t border-secondary/30 border-dashed"
      >
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center px-4 py-16 lg:p-0"
        >
          <div class="lg:p-8 flex justify-center lg:order-1">
            <Image
              src={moccamasterImage}
              alt="Moccamaster KBGV Select Coffee Brewer"
              class="rounded-lg overflow-hidden max-w-lg"
            />
          </div>
          <div class="lg:px-8 lg:py-24">
            <p class="text-xs font-mono uppercase opacity-70 tracking-widest">
              Tier two&nbsp;&not;
            </p>
            <h2
              class="my-4 text-3xl sm:text-5xl tracking-tight text-balance text-primary leading-[1.1]"
            >
              Moccamaster KBGV Select Coffee Brewer
            </h2>
            <p class="md:text-xl opacity-70">
              The Moccamaster KBGV Select brews coffee at the perfect
              temperature and speed, which is why it's certified by coffee nerds
              everywhere. It's built like a tank in the Netherlands, looks great
              on the counter, and makes consistently excellent drip coffee. If
              someone's still using a cheap Mr. Coffee, this is a serious
              upgrade that'll last them years.
            </p>
            <div class="mt-8">
              <Button href="https://amzn.to/4oupwMa">Purchase</Button>
            </div>
            {
              tierTwoAccessories.length ? (
                <div class="mt-8">
                  <p class="text-xs font-mono uppercase opacity-70 tracking-widest">
                    Extra accessories:
                  </p>
                  <ul class="mt-4 grid grid-cols-5 gap-2 md:gap-4">
                    {tierTwoAccessories.map((item) => {
                      if (!item) return null;
                      return (
                        <li>
                          <TooltipAnchor
                            description={item.title}
                            href={item.link}
                            src={item.img!}
                            alt={item.title}
                            client:load
                          />
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ) : null
            }
          </div>
        </div>
      </li>
      <li
        id="tier-three"
        class="scroll-mt-24 border-t border-secondary/30 border-dashed"
      >
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center px-4 py-16 lg:p-0"
        >
          <div class="lg:p-8 flex justify-center">
            <Image
              src={laMarzoccoLineaMicra}
              alt=""
              class="rounded-lg overflow-hidden max-w-lg"
            />
          </div>
          <div class="lg:px-8 lg:py-24">
            <p class="text-xs font-mono uppercase opacity-70 tracking-widest">
              Tier three&nbsp;&not;
            </p>
            <h2
              class="my-4 text-3xl sm:text-5xl tracking-tight text-balance text-primary leading-[1.1]"
            >
              La Marzocco Linea Micra
            </h2>
            <p class="md:text-xl opacity-70">
              The Kalita Wave 185 is a pour-over dripper that makes brewing feel
              like a little morning ritual. The flat-bottom design and
              three-hole drainage give you an even extraction, so your coffee
              tastes clean and balanced. It's perfect for anyone who wants to
              slow down and actually enjoy the process.
            </p>
            <div class="mt-8">
              <Button href="https://amzn.to/4p7Cxfw">Purchase</Button>
            </div>
            {
              tierThreeAccessories.length ? (
                <div class="mt-8">
                  <p class="text-xs font-mono uppercase opacity-70 tracking-widest">
                    Extra accessories:
                  </p>
                  <ul class="mt-4 grid grid-cols-5 gap-2 md:gap-x-4">
                    {tierThreeAccessories.map((item) => {
                      if (!item) return null;
                      return (
                        <li>
                          <TooltipAnchor
                            description={item.title}
                            href={item.link}
                            src={item.img!}
                            alt={item.title}
                            client:load
                          />
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ) : null
            }
          </div>
        </div>
      </li>
      <li
        id="coffee-subscription"
        class="scroll-mt-24 border-t border-secondary/30 border-dashed rounded-b-lg"
      >
        <div
          class="grid grid-cols-1 lg:grid-cols-4 gap-x-8 items-center px-4 py-16 lg:p-0"
        >
          <div class="lg:px-8 lg:py-24 lg:col-start-2 lg:col-end-4">
            <p class="text-xs font-mono uppercase opacity-70 tracking-widest">
              Coffee Subscription&nbsp;&not;
            </p>
            <h2
              class="my-4 text-3xl sm:text-5xl tracking-tight text-balance text-primary leading-[1.1]"
            >
              Trade Coffee Subscription
            </h2>
            <p class="md:text-xl opacity-70">
              Now that you've got the gear, keep it stocked with Trade Coffee.
              They match you with beans from top roasters based on your taste
              preferences, then ship fresh bags right to your door. It's like
              having a coffee expert curating your stash—no more guessing at the
              grocery store or ending up with stale beans from who knows where.
            </p>
            <div class="mt-8">
              <Button href="https://rwrd.io/ref_2JQN4EP?c">Subscribe</Button>
            </div>
          </div>
        </div>
      </li>
    </ul>
  </section>
</Layout>
