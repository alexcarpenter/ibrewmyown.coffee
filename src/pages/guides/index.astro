---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getSlugFromId, isProd } from "@/utils";

const collection = await getCollection("guides", ({ data }) => {
  return isProd ? data.draft !== true : true;
});

const guides = collection.sort((a, b) => {
  const aDate = a.data.published;
  const bDate = b.data.published;
  return Date.parse(bDate.toString()) - Date.parse(aDate.toString());
});
---

<Layout
  title="Guides"
  description="Explore our comprehensive guides to help you make the most of your coffee setup. From the 2025 holiday gift guide to our espresso buying guide, find recommendations and tips for your brewing journey."
>
  <article class="my-20">
    <header
      class="max-w-lg mx-auto text-pretty border-b border-dashed border-black/10 pb-10"
    >
      <div class="mt-5">
        <h1 class="text-sm font-medium inline">Guides.</h1>
        <p class="inline mt-5 text-sm text-neutral-500">
          Explore our comprehensive guides to help you make the most of your
          coffee setup. From the 2025 holiday gift guide to our espresso buying
          guide, find recommendations and tips for your brewing journey.
        </p>
      </div>
    </header>
    <ul class="max-w-lg mx-auto mt-5">
      {
        guides.map((guide) => {
          const slug = getSlugFromId(guide.id);
          return (
            <li>
              <article class="relative p-4 -mx-4 hover:bg-white rounded-lg transition-colors">
                <h2 class="inline text-sm font-medium">
                  <a
                    href={`/guides/${slug}`}
                    class="before:absolute before:inset-0"
                  >
                    {guide.data.title}.
                  </a>
                </h2>
                <p class="inline text-sm text-muted-foreground">
                  {guide.data.description}
                </p>
              </article>
            </li>
          );
        })
      }
    </ul>
  </article>
</Layout>
