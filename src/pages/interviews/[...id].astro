---
import Layout from "@/layouts/Layout.astro";
import { getSlugFromId, getIndexById, isProd } from "@/utils";
import {
  type CollectionEntry,
  getCollection,
  getEntry,
  render,
} from "astro:content";
import { Image } from "astro:assets";
import { META } from "@/consts";
import GallerySlide from "@/components/gallery-slide.react";
import type { ProductBlipData } from "@/components/product-blip.react";


export async function getStaticPaths() {
  const collection = await getCollection("interviews", ({ data }) => {
    return isProd ? data.draft !== true : true;
  });
  const interviews = collection.sort((a, b) => {
    const aDate = a.data.published;
    const bDate = b.data.published;
    return Date.parse(bDate.toString()) - Date.parse(aDate.toString());
  });
  return interviews.map((interview, index) => {
    const id = getSlugFromId(interview.id);
    const issue = getIndexById(interviews, interview.id);
    const totalIssues = interviews.length;
    const previous =
      index < totalIssues - 1 ? interviews[index + 1] : undefined;
    const next = index > 0 ? interviews[index - 1] : undefined;
    return {
      params: { id },
      props: {
        issue,
        interview,
        previous,
        next,
      },
    };
  });
}
type Props = {
  issue: string;
  interview: CollectionEntry<"interviews">;
  previous: CollectionEntry<"interviews"> | undefined;
  next: CollectionEntry<"interviews"> | undefined;
};
const {
  issue: _issue,
  interview,
  previous: _previous,
  next: _next,
} = Astro.props;
const { Content } = await render(interview);

const galleryWithProducts = interview.data.gallery
  ? await Promise.all(
      interview.data.gallery.map(async (image) => {
        const resolvedProducts: ProductBlipData[] = [];
        if (image.products) {
          for (const p of image.products) {
            const product = await getEntry(p.id);
            if (product) {
              resolvedProducts.push({
                x: p.x,
                y: p.y,
                title: product.data.title,
                link: product.data.link,
              });
            }
          }
        }
        return { ...image, resolvedProducts };
      }),
    )
  : undefined;
---

<Layout
  title={interview.data.title}
  description={interview.data.description}
  image={interview.data.image}
  type="article"
  publishedTime={interview.data.published}
  author={interview.data.title}
  schema={{
    "@context": "https://schema.org",
    "@type": "Article",
    headline: interview.data.title,
    description: interview.data.description,
    image: interview.data.image
      ? new URL(interview.data.image, Astro.site).href
      : undefined,
    datePublished: interview.data.published.toISOString(),
    author: {
      "@type": "Person",
      name: interview.data.title,
    },
    publisher: {
      "@type": "Organization",
      name: META.title,
      logo: {
        "@type": "ImageObject",
        url: new URL(META.image, Astro.site).href,
      },
    },
  }}
>
  <article class="my-20">
    <header class="max-w-lg mx-auto text-pretty">
      <Image
        src={interview.data.avatar}
        width="48"
        height="48"
        alt=""
        class="rounded-full object-cover aspect-square size-10"
      />
      <div class="mt-5">
        <h1 class="text-sm font-medium inline">{interview.data.title}.</h1>
        <p class="inline mt-5 text-sm text-neutral-500">
          {interview.data.description}
        </p>
      </div>
    </header>
    {
      galleryWithProducts ? (
        <div class="embla relative max-w-3xl mx-auto mt-10">
          <div class="embla__viewport">
            <div class="embla__container">
              {galleryWithProducts.map((image, i) => (
                <div class="embla__slide">
                  <GallerySlide
                    client:visible
                    src={image.src}
                    alt={image.alt}
                    loading={i === 0 ? "eager" : "lazy"}
                    products={image.resolvedProducts}
                  />
                </div>
              ))}
            </div>
          </div>
          <div class="embla__dots" />
          <span
            class="absolute top-4 left-4 text-xs font-mono text-accent z-10 inline-flex items-baseline"
            aria-hidden="true"
          >
            FIG_
            <number-flow id="gallery-figcaption" data-will-change />
          </span>
        </div>
      ) : null
    }
    <div class="prose mt-10 max-w-lg mx-auto">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .embla__viewport {
    overflow: hidden;
    width: 100%;
    border-radius: var(--radius-lg);
  }

  .embla__container {
    display: flex;
    touch-action: pan-y pinch-zoom;
    margin-left: calc(var(--spacing) * -4);
  }

  .embla__slide {
    flex: 0 0 100%;
    min-width: 0;
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    padding-left: calc(var(--spacing) * 4);

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: var(--radius-lg);
    }
  }

  .embla__dots {
    display: flex;
    justify-content: center;
    align-items: end;
    height: calc(var(--spacing) * 8);
    gap: calc(var(--spacing) * 2);

    button {
      width: calc(var(--spacing) * 2);
      height: calc(var(--spacing) * 2);
      border-radius: 50%;
      background-color: var(--color-neutral-300);

      &.active {
        background-color: var(--color-neutral-500);
      }
    }
  }
</style>

<script>
  import "number-flow";
  import EmblaCarousel from "embla-carousel";
  import { addDotBtnsAndClickHandlers } from "@/lib/embla";

  const emblaNode = document.querySelector(".embla") as HTMLElement;
  if (!emblaNode) throw new Error("No gallery found");

  const viewportNode = emblaNode.querySelector(
    ".embla__viewport",
  ) as HTMLElement;
  const dotsNode = emblaNode.querySelector(".embla__dots") as HTMLElement;
  const figcaptionElement = document.querySelector(
    "#gallery-figcaption",
  ) as any;

  await customElements.whenDefined("number-flow");

  const emblaApi = EmblaCarousel(viewportNode, {});

  addDotBtnsAndClickHandlers(emblaApi, dotsNode);

  const updateFigcaption = (index: number) => {
    if (figcaptionElement) figcaptionElement.update(index + 1);
  };

  if (figcaptionElement) {
    figcaptionElement.format = {
      minimumIntegerDigits: 3,
      useGrouping: false,
    };
    updateFigcaption(emblaApi.selectedScrollSnap());
  }

  emblaApi.on("select", () => updateFigcaption(emblaApi.selectedScrollSnap()));

  document.addEventListener("astro:before-swap", () => emblaApi.destroy(), {
    once: true,
  });
</script>
