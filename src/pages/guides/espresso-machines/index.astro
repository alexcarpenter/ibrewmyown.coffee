---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/button.astro";
import { ProductGroup } from "@/components/product-group.react";
import brevilleBarristaImage from "@/assets/breville-barista@2x.png";
import laMarzoccoLineaMicra from "@/assets/la-marzocco-linea-micra@2x.png";
import rocketEspressoAppartamentoEspressoMachine from "@/assets/rocket-espresso-appartamento-nera-espresso-machine@2px.png";

const products = await getCollection("products");

const getProductData = (id: string) =>
  products.find((product) => product.id === id)?.data;

const tierOneAccessories = [
  "timemore-coffee-scale-basic-2-0",
  "normcore-spring-loaded-tamper",
  "normcore-wdt-distribution-tool",
  "timemore-coffee-scale-basic-2-0",
].map((id) => getProductData(id));

const tierTwoAccessories = [
  "timemore-sculptor-064s-flat-burr-coffee-bean-grinder",
].map((id) => getProductData(id));

const tierThreeAccessories = ["la-marzocco-pico"].map((id) =>
  getProductData(id),
);
---

<Layout
  title="Home Espresso Machines Buying Guide"
  description="Looking for the right espresso machine for your setup? This guide breaks down three tiers of espresso machines, from easy entry-level options to high-end home machines, so you can find something that fits your space, budget, and how deep you want to go with espresso at home."
>
  <article class="my-20">
    <header
      class="max-w-lg mx-auto text-pretty border-b border-black/10 border-dashed pb-20"
    >
      <div class="mt-5">
        <h1 class="text-sm font-medium inline">
          Home Espresso Machines Buying Guide.
        </h1>
        <p class="inline mt-5 text-sm text-neutral-500">
          Looking for the right espresso machine for your setup? This guide
          breaks down three tiers of espresso machines, from easy entry-level
          options to high-end home machines, so you can find something that fits
          your space, budget, and how deep you want to go with espresso at home.
        </p>
      </div>
    </header>
    <ul>
      <li id="tier-one" class="scroll-mt-20 py-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <div class="flex justify-center">
            <Image
              src={brevilleBarristaImage}
              alt="Breville Barista Express"
              class="rounded-lg overflow-hidden max-w-lg"
            />
          </div>
          <div class="max-w-lg max-lg:mx-auto">
            <p
              class="text-xxs font-mono uppercase text-muted-foreground tracking-widest"
            >
              Tier one&nbsp;&not;
            </p>
            <div class="text-pretty mt-5">
              <h2 class="text-sm font-medium inline">
                Breville Barista Express Espresso Machine.
              </h2>
              <p class="inline text-sm text-muted-foreground">
                The Breville Barista Express is one of the most approachable
                ways to start making real espresso at home. It combines a
                built-in conical burr grinder, PID temperature control, and a
                straightforward interface that helps beginners get consistent
                results quickly. This all-in-one design keeps the learning curve
                manageable while still allowing room to experiment with grind
                size, dose, and extraction.
              </p>
            </div>
            <p class="text-sm text-muted-foreground mt-5">
              If you want hands-on espresso without needing multiple pieces of
              equipment, or the commitment of a prosumer setup, the Barista
              Express hits a sweet spot between convenience, control, and value.
            </p>
            <div class="mt-10">
              <Button href="https://amzn.to/4p8DCUn">Purchase</Button>
            </div>
            {
              tierOneAccessories.length ? (
                <div class="mt-10">
                  <p class="text-xxs font-mono uppercase text-muted-foreground tracking-widest">
                    Extra accessories:
                  </p>
                  <ProductGroup products={tierOneAccessories} client:load />
                </div>
              ) : null
            }
          </div>
        </div>
      </li>
      <li
        id="tier-two"
        class="scroll-mt-20 py-20 border-t border-black/10 border-dashed"
      >
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <div class="flex justify-center lg:order-1">
            <Image
              src={rocketEspressoAppartamentoEspressoMachine}
              alt="Rocket Espresso Appartamento TCA"
              class="rounded-lg overflow-hidden max-w-lg"
            />
          </div>
          <div class="max-w-lg mx-auto lg:ml-auto">
            <p
              class="text-xxs font-mono uppercase text-muted-foreground tracking-widest"
            >
              Tier two&nbsp;&not;
            </p>
            <div class="text-pretty mt-5">
              <h2 class="text-sm font-medium inline">
                Rocket Espresso Appartamento TCA Espresso Machine.
              </h2>
              <p class="inline text-sm text-muted-foreground">
                The Rocket Appartamento TCA is a step into true prosumer
                territory. Built in Italy with commercial-grade components, it
                uses a heat exchanger system that allows you to brew espresso
                and steam milk simultaneously. The E61 group head provides
                excellent temperature stability, while the powerful steam
                performance makes silky microfoam easy to achieve.
              </p>
            </div>
            <p class="text-sm text-muted-foreground mt-5">
              This machine is ideal for espresso lovers who already understand
              the basics and want more control, durability, and aesthetic
              presence. Pair it with a quality grinder and you'll have a setup
              capable of rivaling many cafés.
            </p>
            <div class="mt-10">
              <Button href="https://amzn.to/4sPLX1B">Purchase</Button>
            </div>
            {
              tierTwoAccessories.length ? (
                <div class="mt-10">
                  <p class="text-xxs font-mono uppercase text-muted-foreground tracking-widest">
                    Extra accessories:
                  </p>
                  <ProductGroup products={tierTwoAccessories} client:load />
                </div>
              ) : null
            }
          </div>
        </div>
      </li>
      <li
        id="tier-three"
        class="scroll-mt-20 py-20 border-t border-black/10 border-dashed"
      >
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <div class="flex justify-center">
            <Image
              src={laMarzoccoLineaMicra}
              alt="La Marzocco Linea Micra"
              class="rounded-lg overflow-hidden max-w-lg"
            />
          </div>
          <div class="max-w-lg max-lg:mx-auto">
            <p
              class="text-xxs font-mono uppercase text-muted-foreground tracking-widest"
            >
              Tier three&nbsp;&not;
            </p>
            <div class="text-pretty mt-5">
              <h2 class="text-sm font-medium inline">
                La Marzocco Linea Micra.
              </h2>
              <p class="inline text-sm text-muted-foreground">
                The La Marzocco Linea Micra brings commercial espresso
                engineering into a compact home machine. Featuring dual boilers,
                exceptional thermal stability, and digital control via the La
                Marzocco Home app, it delivers consistency shot after shot with
                virtually no warm-up compromise. The build quality is
                exceptional, designed to last for decades rather than years.
              </p>
            </div>
            <p class="text-sm text-muted-foreground mt-5">
              This machine is for those who see espresso as a craft and want the
              same level of control and reliability used by professional cafés,
              without dedicating an entire counter to a commercial machine. It's
              the pinnacle of home espresso performance.
            </p>
            <div class="mt-10">
              <Button href="https://amzn.to/4p7Cxfw">Purchase</Button>
            </div>
            {
              tierThreeAccessories.length ? (
                <div class="mt-10">
                  <p class="text-xxs font-mono uppercase text-muted-foreground tracking-widest">
                    Extra accessories:
                  </p>
                  <ProductGroup products={tierThreeAccessories} client:load />
                </div>
              ) : null
            }
          </div>
        </div>
      </li>
      <li
        id="coffee-subscription"
        class="scroll-mt-20 pt-20 border-t border-black/10 border-dashed"
      >
        <div class="max-w-lg mx-auto">
          <p
            class="text-xxs font-mono uppercase text-muted-foreground tracking-widest"
          >
            Coffee Subscription&nbsp;&not;
          </p>
          <div class="mt-5 text-pretty">
            <h2 class="inline text-sm font-medium">
              Trade Coffee Subscription.
            </h2>
            <p class="inline text-sm text-muted-foreground">
              Now that you've got the gear, keep it stocked with Trade Coffee.
              They match you with beans from top roasters based on your taste
              preferences, then ship fresh bags right to your door. It's like
              having a coffee expert curating your stash—no more guessing at the
              grocery store or ending up with stale beans from who knows where.
            </p>
          </div>
          <div class="mt-10">
            <Button href="https://rwrd.io/ref_2JQN4EP?c">Subscribe</Button>
          </div>
        </div>
      </li>
    </ul>
  </article>
</Layout>
