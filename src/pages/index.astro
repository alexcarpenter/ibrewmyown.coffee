---
import { getSlugFromId, isProd } from "@/utils";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { META } from "@/consts";

const collection = await getCollection("interviews", ({ data }) => {
  return isProd ? data.draft !== true : true;
});

const interviews = collection.sort((a, b) => {
  const aDate = a.data.published;
  const bDate = b.data.published;
  return Date.parse(bDate.toString()) - Date.parse(aDate.toString());
});
---

<Layout
  title="Home Coffee Brewing Setups"
  description="Discover home coffee brewing setups from coffee enthusiasts, baristas, and professionals. Explore espresso machines, pour-over methods, grinders, and specialty coffee equipment."
  schema={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": META.title,
    "url": Astro.site?.href,
    "description": "A collection of personal coffee brewing setups from coffee enthusiasts and professionals.",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": `${Astro.site?.href}interviews/{search_term_string}`
      },
      "query-input": "required name=search_term_string"
    }
  }}
>
  <h1 class="sr-only">Home Coffee Brewing Setups - Interviews</h1>
  <section class="interviews">
    {
      interviews.map((interview) => {
        const thumbnail = interview.data.gallery?.at(0);
        return (
          <article class="rounded-lg flex overflow-hidden bg-white group/card relative">
            <div class="p-4 flex-1">
              <Image
                src={interview.data.avatar}
                width="32"
                height="32"
                alt=""
                class="rounded-full object-cover aspect-square size-10"
              />
              <h2 class="font-medium mt-64 text-sm">
                <a
                  href={`/interviews/${getSlugFromId(interview.id)}`}
                  class="before:absolute before:inset-0 before:z-10 pe-3.5 inline-block"
                >
                  {interview.data.title}
                  <span class="absolute h-[1lh] inline-flex items-center pl-1 overflow-clip">
                    <Icon
                      name="arrow-right"
                      class="size-3.5 opacity-0 group-hover/card:opacity-70 motion-reduce:transition-none duration-250 -translate-x-6 group-hover/card:translate-x-0 transition ease-custom"
                    />
                  </span>
                </a>
              </h2>
              <p class="text-sm line-clamp-2 h-10 opacity-60">
                {interview.data.description}
              </p>
            </div>
            {thumbnail ? (
              <div class="thumbnail flex-1 relative hidden p-4">
                <Image
                  src={thumbnail.src}
                  width={600}
                  height={600}
                  alt={interview.data.title}
                  class="object-cover size-full absolute inset-0"
                />
              </div>
            ) : null}
          </article>
        );
      })
    }
  </section>
</Layout>

<style>
  .interviews {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .interviews article:nth-child(2n + 1) {
    background-color: var(--color-accent);
  }

  @media (min-width: 768px) {
    .interviews {
      grid-template-columns: repeat(2, 1fr);
    }

    .interviews article:nth-child(2n + 1) {
      background-color: var(--color-white);
    }

    .interviews article:nth-child(2n + 1) .thumbnail {
      display: none;
    }

    .interviews article:nth-child(3n + 1) {
      grid-column: span 2;
      background-color: var(--color-accent);
    }

    .interviews article:nth-child(3n + 1) .thumbnail {
      display: block;
    }
  }

  @media (min-width: 1024px) {
    .interviews {
      grid-template-columns: repeat(4, 1fr);
    }

    .interviews article:nth-child(3n + 1) {
      grid-column: span 1;
      background-color: var(--color-white);
    }

    .interviews article:nth-child(3n + 1) .thumbnail {
      display: none;
    }

    .interviews article:nth-child(6n + 1),
    .interviews article:nth-child(6n) {
      grid-column: span 2;
      background-color: var(--color-accent);
    }

    .interviews article:nth-child(6n + 1) .thumbnail,
    .interviews article:nth-child(6n) .thumbnail {
      display: block;
    }
  }
</style>
